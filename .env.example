# ---------- Database ----------
# Local (Docker profile local-db): MYSQL_HOST=mysql, MYSQL_USER=root
# Server: IP of the external MySQL server and a dedicated user
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=hse_db
# Optional: host port for the local MySQL container
# MYSQL_HOST_PORT=33061

# ---------- Docker profiles ----------
# Local: COMPOSE_PROFILES=local-db,local-storage
# Server: leave unset
COMPOSE_PROFILES=

# ---------- Object storage (MinIO) ----------
# Local container: MINIO_ENDPOINT=minio:9000, MINIO_USE_SSL=false
# Central storage: host only, no http(s):// prefix, MINIO_USE_SSL=true for HTTPS
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_BUCKET=vessel-documents
# Only for the local container (same values as the access key above)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# MINIO_CONSOLE_PORT=9001

# ---------- App ----------
BACKEND_PORT=3000
FRONTEND_PORT=80
FRONTEND_URL=http://localhost:5173
JWT_SECRET=

# ---------- Microsoft Entra ID ----------
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:5173/auth/callback

# ---------- SMTP (leave SMTP_HOST empty to disable sending) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HSE Approval System
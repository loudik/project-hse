# Format DSN go-sql-driver/mysql: USER:PASSWORD@tcp(HOST:PORT)/DBNAME?parseTime=true
DB_DSN="root:password@tcp(127.0.0.1:3306)/hse_db?parseTime=true"

PORT=3000

# Generate a long random string for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# Microsoft Entra ID (Azure AD) App Registration
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:5173/auth/callback

# Used to build links sent in emails (e.g. email verification link)
FRONTEND_URL=http://localhost:5173
